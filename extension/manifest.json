{
  "manifest_version": 3,
  "name": "Life System focus helper",
  "version": "1.0.0",
  "description": "During a Life System focus timer, distracting sites show \u201cafter the block\u201d. Asks only your own PC (127.0.0.1).",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
