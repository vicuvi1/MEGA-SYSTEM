{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/telegram.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/cron.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/ai.mjs": {
      "maxDuration": 60
    },
    "api/coach.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/todoist.mjs": {
      "maxDuration": 60
    },
    "api/tick.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=morning",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron?job=reask",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron?job=midday",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron?job=evening",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron?job=night",
      "schedule": "15 20 * * *"
    }
  ]
}
