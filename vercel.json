{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/telegram.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/cron.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/ai.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/coach.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    "api/todoist.mjs": {
      "maxDuration": 60
    },
    "api/mcp.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm"
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=morning",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron?job=reask",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron?job=midday",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron?job=evening",
      "schedule": "30 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/google-callback",
      "destination": "/api/google?callback=1"
    },
    {
      "source": "/api/bot-health",
      "destination": "/api/bot-setup?health=1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/hook",
      "destination": "/api/mcp?op=hook"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?wk=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?wk=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?wk=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp?wk=as"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/((?!api/|apps/|mcp|\\.well-known/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/phonemizer@1.2.1/dist/phonemizer.js https://w.soundcloud.com/player/api.js; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.turso.io https://generativelanguage.googleapis.com https://openrouter.ai https://api.telegram.org https://open.er-api.com https://api.binance.com https://huggingface.co https://*.hf.co https://cdn.jsdelivr.net; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' https://w.soundcloud.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(api/.*|mcp|\\.well-known/.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
