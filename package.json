{
  "name": "life-system",
  "version": "1.4.0",
  "private": true,
  "description": "Life System - one points wallet, many sections",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && electron .",
    "dev:legacy": "electron-vite dev",
    "build": "vite build --config vite.web.mts",
    "build:electron": "npm run build:web && electron-vite build --config electron.desktop.config.mts && node scripts/copy-desktop-ui.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "web": "vite --config vite.web.mts",
    "build:web": "vite build --config vite.web.mts",
    "build:bot": "vite build --config vite.bot.mts",
    "vercel-build": "vitest run && tsc --noEmit -p tsconfig.json && vite build --config vite.web.mts",
    "dist": "npm run build:electron && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "smoke": "npm run build:web && node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scrypt-js": "^3.0.1",
    "sql.js": "^1.15.2"
  },
  "productName": "Life System",
  "author": "Victor Barbuta",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicuvi1/MEGA-SYSTEM.git"
  },
  "build": {
    "appId": "com.vicuvi1.lifesystem",
    "productName": "Life System",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!node_modules/better-sqlite3/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps",
        "to": "apps"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Life-System-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Life System",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vicuvi1",
        "repo": "MEGA-SYSTEM",
        "private": true,
        "releaseType": "release"
      }
    ]
  }
}
